include("${CMAKE_CURRENT_LIST_DIR}/ApfsUtilTest.cmake")

run(0 --help)
contains("${output}" "--metadata-only")
contains("${output}" "Exit status:")
run(0 -h)
run(2)
run(2 --metadata-only)
run(2 --)
run(2 --unknown)
run(2 --metadata-only --metadata-only valid.img)
run(2 valid.img extra.img)
run(2 --metadata-only valid.img extra.img)
run(1 --metadata-only missing.img)
run(1 missing.img)

run(1 key-failure.img)
contains("${errors}" "Initialization of KeyManager failed")
contains("${errors}" "Unable to open APFS container")
run(0 --metadata-only key-failure.img)
contains("${output}" "key manager skipped")
contains("${output}" "Name: +Data")
contains("${output}" "Name: +System")
contains("${output}" "Name: +Data\nCapacity Consumed: +0 Bytes\nFileVault: +Yes")
contains("${output}" "Name: +System\nCapacity Consumed: +0 Bytes\nFileVault: +No")
contains("${output}" "42 : 'test-snapshot'")
if (NOT "${errors}" STREQUAL "")
	message(FATAL_ERROR "Unexpected metadata errors: ${errors}")
endif()

run(0 valid.img)
contains("${output}" "Name: +Data")
if ("${output}" MATCHES "key manager skipped")
	message(FATAL_ERROR "Default invocation skipped the key manager")
endif()
run(0 valid.img --metadata-only)
run(0 no-keylocker.img)
run(0 --metadata-only no-keylocker.img)
file(COPY "${TEST_DIR}/valid.img" DESTINATION "${TEST_DIR}/copy")
file(RENAME "${TEST_DIR}/copy/valid.img" "${TEST_DIR}/-device.img")
run(0 --metadata-only -- -device.img)

foreach(name bad-magic bad-block-0 bad-block-1 bad-block-3 bad-block-4 bad-block-5)
	run(1 --metadata-only "${name}.img")
	contains("${errors}" "Unable to open APFS container")
endforeach()
foreach(name bad-volume bad-volume-magic bad-volume-type missing-volume)
	run(3 --metadata-only "${name}.img")
	contains("${errors}" "Volume 0: metadata unavailable or unreadable")
	contains("${output}" "Name: +System")
endforeach()
foreach(name bad-snapshots missing-snapshots bad-first-snapshot bad-later-snapshot bad-snapshot-name
	snapshot-short-key snapshot-short-value snapshot-missing-value snapshot-empty-name snapshot-unterminated-name)
	run(3 --metadata-only "${name}.img")
	contains("${errors}" "Volume 0: snapshot metadata unavailable or unreadable")
	contains("${output}" "Name: +System")
endforeach()
run(3 --metadata-only bad-later-snapshot.img)
contains("${output}" "42 : 'test-snapshot'")
run(0 --metadata-only branched.img)
contains("${output}" "43 : 'test-snapshot'")
run(0 --metadata-only empty-snapshots.img)
run(1 --metadata-only encrypted.dmg)
run(1 --metadata-only encrypted.sparseimage)
message(STATUS "Metadata API and apfsutil CLI tests passed")
